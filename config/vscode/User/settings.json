{
    "workbench.iconTheme": "vscode-icons",
    "editor.linkedEditing": true,
    "editor.fontFamily": "'IosevkaTerm NF', 'Droid Sans Mono', 'DroidSansM Nerd Font Mono', monospace",
    "editor.fontVariations": false,
    "files.associations": {
        "config": "properties",
        "custom": "rust",
        "*.desktop": "properties"
    },
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "/usr/bin/fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.linux": "fish",
    "git.blame.editorDecoration.enabled": true,
    "workbench.colorCustomizations": {
        "git.blame.editorDecorationForeground": "#3e4242",
    },
    "terminal.integrated.fontSize": 16,
    "editor.fontSize": 16,
    "git.openRepositoryInParentFolders": "never",
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://spec.openapis.org/": true,
        "https://www.schemastore.org/": true
    }
}